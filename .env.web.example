# ── CRM DEMO · versión WEB ─────────────────────────────────────────────────
# Copia este archivo como  .env.web  (mismo nombre, sin «.example») y llénalo.
# .env.web NUNCA se sube a GitHub (está en .gitignore). No lo compartas por WhatsApp ni correo.
#
# Estos mismos valores los vas a pegar después en Render (ver DESPLIEGUE-WEB.md).

# ── 1) NEON (la base de datos) ────────────────────────────────────────────
# En neon.tech → tu proyecto → botón «Connect» (arriba).
#   · DATABASE_URL = la cadena CON pooler (el interruptor «Connection pooling» ENCENDIDO;
#     el host trae «-pooler» en el nombre). Al final añade:
#       &pgbouncer=true&connect_timeout=30&connection_limit=5
#     (si la cadena ya trae «?sslmode=require», solo agrega lo que va después).
DATABASE_URL="postgresql://USUARIO:CLAVE@ep-algo-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=30&connection_limit=5"
#   · DIRECT_URL = la cadena SIN pooler (interruptor «Connection pooling» APAGADO;
#     el host NO tiene «-pooler»). Sin cambios al final: "...neondb?sslmode=require".
DIRECT_URL="postgresql://USUARIO:CLAVE@ep-algo.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ── 2) SUPABASE (donde se guardan los PDF y las fotos) ───────────────────
# En supabase.com → tu proyecto → Project Settings (engranaje) → API (o «Data API»).
#   · SUPABASE_URL = «Project URL», p. ej. https://abcdefghijk.supabase.co
SUPABASE_URL="https://TU-PROYECTO.supabase.co"
#   · SUPABASE_SERVICE_ROLE_KEY = la clave «service_role» (la SECRETA, no la «anon»).
#     En «API Keys» pulsa «Reveal». Es como una llave maestra: no la compartas.
SUPABASE_SERVICE_ROLE_KEY=""
#   · Nombre del bucket PRIVADO que creaste en Storage.
SUPABASE_BUCKET="crm-files"
STORAGE_DRIVER="supabase"

# ── 3) Valores fijos ──────────────────────────────────────────────────────
APP_TIMEZONE="America/Bogota"

# ── 4) AUTH_SECRET (solo si pruebas la web en tu PC) ─────────────────────
# En Render NO hace falta: Render lo inventa solo. Si quieres probar en tu PC,
# genera uno en una terminal con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# y pégalo aquí:
AUTH_SECRET=""
