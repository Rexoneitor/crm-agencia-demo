# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.web.example

# datos locales: base de datos, archivos subidos, backups
/data
/prisma/data

# vitest
/coverage

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# skill packs instalados por herramientas de edicion (no forman parte del CRM)
/.claude/skills
/.cursor
