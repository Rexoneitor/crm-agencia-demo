# ── Plantilla de variables de entorno ──────────────────────────────────────
# Copia este archivo a .env y rellena los valores. NUNCA pongas secretos
# reales en este archivo (sí se versiona).

# Base de datos.
#   Local (SQLite):  file:../data/crm.db   (relativo a prisma/schema.prisma)
#   Nube  (Postgres): postgresql://user:pass@host:5432/crm
DATABASE_URL="file:../data/crm.db"

# Secreto para firmar cookies de sesión (mín. 32 caracteres).
# Genera:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# Zona horaria de operación (IANA). Ej: America/Bogota
APP_TIMEZONE="America/Bogota"

# Carpeta de archivos subidos
FILES_DIR="./data/files"

# Backups: carpeta principal y carpeta secundaria (medio distinto)
BACKUP_PRIMARY_DIR="./data/backups"
BACKUP_SECONDARY_DIR=""

# Puerto del servidor
PORT="3200"
